# Base URL for the wordle-svc backend, read by the app as import.meta.env.VITE_API_URL.
# Default (leave unset) is the relative path "/service", which Vite proxies to the
# deployed Lambda in dev (see vite.config.ts). Set this to point at a same-origin
# reverse proxy or a CORS-enabled endpoint in other environments.
VITE_API_URL=/service

# Optional: override the dev proxy target (where "/service" is forwarded in `npm run dev`).
# Defaults to the deployed Lambda Function URL in vite.config.ts.
# VITE_PROXY_TARGET=https://3a4sqenzhvr7ytnxakcsjeeh5u0hbynu.lambda-url.us-east-1.on.aws/
